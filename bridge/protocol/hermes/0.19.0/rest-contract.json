   "commit": "9de9c25f620ff7f1ce0fd5457d596052d5159596"
  }
 },
 "features": {
  "chat_completions": true,
  "chat_completions_streaming": true,
  "responses_api": true,
  "responses_streaming": true,
  "run_submission": true,
  "run_status": true,
  "run_events_sse": true,
  "run_stop": true,
  "run_approval_response": true,
