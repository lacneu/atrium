# Static SPA server for atrium. HTTP only — TLS + the public domain are
# handled upstream by Traefik (file-provider) on the NAS.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode gzip zstd

	# /config.json is written at boot by the entrypoint from $CONVEX_URL and read
	# by the SPA at boot (src/lib/runtimeConfig.ts). Never cache it so a redeploy
	# or env change is picked up immediately.
	@config path /config.json
	header @config Cache-Control "no-store"

	# Hashed build assets are immutable → cache hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The SPA shell (index.html, served for every non-asset route via the fallback
	# below) must ALWAYS revalidate, so a new deploy is picked up without a manual
	# hard-refresh. Everything that isn't a hashed asset or /config.json = the shell.
	@html {
		not path /assets/*
		not path /config.json
	}
	header @html Cache-Control "no-cache"

	# SPA routing: serve real files first (so /config.json and /assets are NOT
	# shadowed), fall back to index.html for client-side routes.
	try_files {path} /index.html
	file_server
}

# Inline-widget sandbox origin (optional feature, harmless when unused): serves ONLY
# Atrium's pinned copy of the widget sandbox proxy, with the exact headers upstream
# sends with it. Route a DEDICATED hostname (never Atrium's, never the gateway's) to
# this port behind TLS and set WIDGET_SANDBOX_ORIGIN to it — docs/WIDGETS.md. Kept
# byte-identical to deploy/widget-sandbox/Caddyfile (src/chat/widgets/widgetSandbox.test.ts).
:8081 {
	root * /srv-widget-sandbox
	@proxy path /
	handle @proxy {
		header {
			Content-Type "text/html; charset=utf-8"
			Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.bunny.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.bunny.net; img-src 'self' data: https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.bunny.net; media-src 'self' data: https: blob:; font-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://fonts.bunny.net; connect-src 'none'; webrtc 'block'; frame-src 'none'; base-uri 'self'; object-src 'none'; form-action 'none'; frame-ancestors http: https:"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), clipboard-write=()"
			Cross-Origin-Resource-Policy "cross-origin"
			Origin-Agent-Cluster "?1"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			Cache-Control "no-cache"
		}
		rewrite * /index.html
		file_server
	}
	handle {
		respond "Not Found" 404
	}
}
